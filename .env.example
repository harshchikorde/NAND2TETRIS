# =============================================================================
# NAND2TETRIS — Environment Configuration EXAMPLE
# =============================================================================
# This is a template. Copy this file to .env and fill in your actual paths.
# Do NOT commit .env to version control (add it to .gitignore).
# =============================================================================

# Base project directory
NAND2TETRIS_PROJECTS_DIR=/path/to/your/nand2tetris/projects

# Assembler input
ASM_INPUT_PATH=/path/to/your/nand2tetris/projects/06/max/Max.asm

# VM Translator input
VM_INPUT_PATH=/path/to/your/nand2tetris/projects/08/FunctionCalls/StaticsTest/Class2.vm
VM_BOOTSTRAP=False

# Jack Compiler I input
COMP_INPUT_PATH=/path/to/your/nand2tetris/projects/10/ExpressionLessSquare/SquareGame.jack

# Jack Compiler II input
COMP2_INPUT_PATH=/path/to/your/nand2tetris/projects/10/ExpressionLessSquare/SquareGame.jack

# Intermediate / temp files
TEMP_PARSED_FILE=/path/to/your/nand2tetris/projects/sampleparsed.txt
TEMP_TOKEN_XML=/path/to/your/nand2tetris/projects/token.xml
TEMP_TTOKEN_XML=/path/to/your/nand2tetris/projects/ttoken.xml
TEMP_VM_CODE=/path/to/your/nand2tetris/projects/vm_code.vm
